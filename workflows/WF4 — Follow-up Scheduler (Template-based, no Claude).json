      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT o.*, c.id as conversation_id, c.state as conversation_state \nFROM owners o \nLEFT JOIN conversations c ON c.owner_id = o.id \nWHERE o.status = 'waiting_reply' \nAND o.last_contact_at < NOW() - INTERVAL '24 hours' \nAND o.follow_up_count < 3 \nAND o.status NOT IN ('human_review', 'won', 'lost') \nORDER BY o.priority_score DESC \nLIMIT 10",
        "options": {}
      },
